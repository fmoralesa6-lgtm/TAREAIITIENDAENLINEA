      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login devuelve 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Devuelve token JWT', () => pm.expect(data.token).to.be.a('string').and.not.empty);",
              "if (pm.response.code === 200 && data.token) pm.collectionVariables.set('jwt', data.token);"
            ]
          }
        }
